# Public site URLs (no trailing slash required)
# Frontend SPA
FRONTEND_URL=https://mysewa.sewabyapar.com/
# Django API host; include /database for the admin path
BACKEND_URL=https://mysewaserver.sewabyapar.com/database

# Optional: comma-separated hosts (defaults derived from FRONTEND_URL / BACKEND_URL)
# ALLOWED_HOSTS=mysewa.sewabyapar.com,mysewaserver.sewabyapar.com,localhost,127.0.0.1
# CORS_ALLOW_ALL_ORIGINS=true

# HimalPay Reseller API (LIVE production)
# UAT (testing only): https://uatapi.himalpay.com.np/api/v1
HIMALPAY_BASE_URL=https://api.himalpay.com.np/api/v1
HIMALPAY_API_KEY=your-himalpay-live-api-key
HIMALPAY_BYPASS_API=false
HIMALPAY_TIMEOUT=60

# N-Cash Merchant Checkout (wallet deposit / payin)
# Optional dedicated key: merchant portal → API Keys Settings → Web Checkout
# Auth header: X-Checkout-API-Key
# Do not paste the reseller HIMALPAY_API_KEY here — HimalPay rejects it on
# checkout-initiate (401 invalid checkout api key). Leave empty until the
# Web Checkout key is added; bills/top-up/payout keep using HIMALPAY_API_KEY.
HIMALPAY_CHECKOUT_API_KEY=
HIMALPAY_CHECKOUT_BASE_URL=https://api.himalpay.com.np/api/v1
# Optional override. Default is {BACKEND_ORIGIN}/api/deposit/checkout/return/?order=<id>
# which verifies via checkout-status then redirects to /app/checkout-return.
HIMALPAY_CHECKOUT_RETURN_URL=

# FCM / Firebase Cloud Messaging (HTTP v1)
# Drop the downloaded service-account JSON at server/firebase-service.json
# (or server/firebase-service-account.json) and point FIREBASE_CREDENTIALS_PATH at it.
# FIREBASE_CREDENTIALS_PATH=firebase-service.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_PROJECT_ID=
# Legacy server key is optional fallback only (deprecated by Google)
# FCM_SERVER_KEY=
