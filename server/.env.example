# Public site URLs (no trailing slash required)
# Frontend SPA
FRONTEND_URL=https://mysewa.sewabyapar.com/
# Django API host; include /database for the admin path
BACKEND_URL=https://mysewaserver.sewabyapar.com/database

# Optional: comma-separated hosts (defaults derived from FRONTEND_URL / BACKEND_URL)
# ALLOWED_HOSTS=mysewa.sewabyapar.com,mysewaserver.sewabyapar.com,localhost,127.0.0.1
# CORS_ALLOW_ALL_ORIGINS=true

# HimalPay Reseller API (LIVE production)
# UAT (testing only): https://uatapi.himalpay.com.np/api/v1
HIMALPAY_BASE_URL=https://api.himalpay.com.np/api/v1
HIMALPAY_API_KEY=your-himalpay-live-api-key
HIMALPAY_BYPASS_API=false
HIMALPAY_TIMEOUT=60
