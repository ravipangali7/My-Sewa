[Unit]
Description=MySewa Django API (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mysewa/server
EnvironmentFile=/var/www/mysewa/server/.env
ExecStart=/var/www/mysewa/server/../env/bin/gunicorn -c /var/www/mysewa/deploy/gunicorn.conf.py mysewa_backend.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
