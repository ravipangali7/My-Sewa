# Optional timer to run HimalPay statement reconciliation daily.
#
# Install (Linux):
#   sudo cp deploy/mysewa-statement-reconcile.service /etc/systemd/system/
#   sudo cp deploy/mysewa-statement-reconcile.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mysewa-statement-reconcile.timer
#
# Windows Task Scheduler (example):
#   Program: C:\CODE\My_sewa\env\Scripts\python.exe
#   Arguments: manage.py reconcile_himalpay_statement
#   Start in: C:\CODE\My_sewa\server
#   Trigger: Daily at 23:30 (Asia/Kathmandu)

[Unit]
Description=MySewa HimalPay statement reconcile
After=network.target mysewa-api.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/mysewa/server
EnvironmentFile=/var/www/mysewa/server/.env
ExecStart=/var/www/mysewa/server/../env/bin/python manage.py reconcile_himalpay_statement
